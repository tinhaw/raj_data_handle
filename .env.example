RAJ_ENVIRONMENT=development
RAJ_DATABASE_URL=postgresql+asyncpg://raj_data_handle:raj_data_handle@localhost:5432/raj_data_handle
RAJ_REDIS_URL=redis://localhost:6379/0
RAJ_SECRET_KEY=replace-with-at-least-32-random-characters
# 32-byte URL-safe base64 key. Generate with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
RAJ_CREDENTIAL_ENCRYPTION_KEY=
RAJ_SESSION_TTL_DAYS=30
RAJ_SESSION_COOKIE_SECURE=false
RAJ_CORS_ORIGINS=["http://localhost:5173"]
RAJ_STORAGE_ROOT=runtime/uploads
RAJ_UPLOAD_MAX_BYTES=52428800
RAJ_UPLOADED_FILE_RETENTION_DAYS=3
RAJ_RESULT_RETENTION_DAYS=30
RAJ_REMOTE_CACHE_RETENTION_DAYS=30

# Only used by compose.yaml. Prefer URL-safe alphanumeric characters because
# the same value is interpolated into RAJ_DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-database-password
WEB_PORT=8080
