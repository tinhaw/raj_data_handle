# Local-only application values for Raj Data Handle production deployment.
# Copy to deploy/secrets/raj-data-handle.env, then fill every blank value locally.
# The RDS host, port and database are read from configs/deployments.local.yml.

RAJ_RDS_USERNAME=
RAJ_RDS_PASSWORD=

RAJ_SECRET_KEY=
# Generate with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
RAJ_CREDENTIAL_ENCRYPTION_KEY=

RAJ_UPLOAD_MAX_BYTES=52428800
RAJ_UPLOADED_FILE_RETENTION_DAYS=3
RAJ_RESULT_RETENTION_DAYS=30
RAJ_REMOTE_CACHE_RETENTION_DAYS=30
